{
  "manifest_version": 3,
  "name": "Tech Stack Analyzer",
  "version": "1.0.0",
  "description": "利用AI分析网站技术栈的Chrome插件",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["marked.min.js", "purify.min.js", "content.js"],
      "css": []
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tech Stack Analyzer",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "options_page": "config.html",
  "icons": {
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "config.html",
        "history.html",
        "marked.min.js",
        "purify.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

